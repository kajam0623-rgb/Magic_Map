# 선택 사항: 없으면 OpenStreetMap 지도로 자동 전환됩니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=카카오_JavaScript_앱_키

# 서버 전용: 네이버 검색광고 API 검색량 조회에 사용합니다.
# NEXT_PUBLIC_ prefix를 붙이지 마세요.
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_BASE_URL=https://api.searchad.naver.com

# 선택 사항: 카카오 로컬 API REST 키. 있으면 키워드별 경쟁 업체 수를 세어
# 기회 지수(검색량 ÷ 경쟁 업체 수)를 함께 계산합니다. 없으면 검색량만 나옵니다.
# 지도용 JavaScript 키와 다른 값입니다.
KAKAO_REST_API_KEY=
